# Local development placeholders for the ingest-crossref Edge Function.
# Copy to .env (gitignored) and fill in real values locally.
# Never commit real secrets.
#
# PLATFORM-PROVIDED (Supabase injects these automatically in deployed
# functions; do NOT set them via `supabase secrets set`):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=platform-provided-service-role-key
#
# CUSTOM SECRETS (the only ones set via `supabase secrets set`):
CROSSREF_MAILTO=you@example.com
INGEST_CRON_SECRET=your-long-random-ingestion-secret
